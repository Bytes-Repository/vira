;; ── settings ─────────────────────────────────────────────────────────────────

fn read_input(prompt: string) -> string is
    io_print(prompt)
    let tmp: string = "/tmp/.vira_settings_input_" + to_string(proc_id()) + "_" + to_string(time_ms())
    system("read -r __vira_in; printf '%s' \"$__vira_in\" > '" + tmp + "'")
    let val: string = string_trim(file_read(tmp))
    system("rm -f '" + tmp + "'")
    return val
end

pub fn cmd_settings() is
    write("\x1b[1m\x1b[36mvira settings\x1b[0m")
    write("  \x1b[2mConfig: " + prefs::prefs_path() + "\x1b[0m")
    write("")
    write("  \x1b[1m[1]\x1b[0m Default backend (release/debug)")
    write("  \x1b[1m[2]\x1b[0m Progress bar style")
    write("  \x1b[1m[3]\x1b[0m Clear project build cache")
    write("  \x1b[1m[4]\x1b[0m Show build cache size")
    write("  \x1b[1m[5]\x1b[0m Show current settings")
    write("  \x1b[1m[6]\x1b[0m Reset settings to defaults")
    write("  \x1b[1m[7]\x1b[0m Clear the global library store (~/.hsharp/bytes-io)")
    write("  \x1b[1m[q]\x1b[0m Quit")

    let choice: string = read_input("\n  Choice: ")

    if choice == "1" is
        let backend: string = read_input("  Backend [release/debug]: ")
        prefs::set("backend", backend)
        write("  \x1b[32m✓\x1b[0m saved")
    else if choice == "2" is
        write("")
        let names: [string] = ui::theme_names()
        let current: string = prefs::get("bar_theme", "default")
        let mut i: int = 0
        while i < array_len(names) is
            let marker: string = if names[i] == current then "\x1b[32m*\x1b[0m" else " "
            write("  " + marker + " \x1b[1m[" + to_string(i + 1) + "]\x1b[0m " +
                  string_pad_right(names[i], 9) + " \x1b[36m" + ui::theme_preview(names[i]) + "\x1b[0m")
            i += 1
        end
        let pick: string = read_input("\n  Choice: ")
        let idx: int = to_int(pick) - 1
        if idx >= 0 && idx < array_len(names) is
            prefs::set("bar_theme", names[idx])
            write("  \x1b[32m✓\x1b[0m bar theme set to \x1b[36m" + names[idx] + "\x1b[0m " + ui::theme_preview(names[idx]))
        else is
            write("  \x1b[31m✗\x1b[0m invalid choice")
        end
    else if choice == "3" is
        dir_remove_all("build/cache")
        write("  \x1b[32m✓\x1b[0m build/cache removed")
    else if choice == "4" is
        system("du -sh build/cache 2>/dev/null | awk '{{print \"  Cache: \" $1}}' || echo '  Cache: 0'")
    else if choice == "5" is
        let dump: string = prefs::dump()
        if dump == "" is
            write("  \x1b[2m(no settings saved yet — using built-in defaults)\x1b[0m")
        else is
            write("")
            write("  \x1b[2m" + prefs::prefs_path() + "\x1b[0m")
            write(dump)
        end
    else if choice == "6" is
        prefs::reset()
        write("  \x1b[32m✓\x1b[0m settings reset to defaults")
    else if choice == "7" is
        store::wipe_packages()
        store::wipe_pyenv()
        write("  \x1b[32m✓\x1b[0m " + store::packages_root() + " and " + store::pyenv_root() + " cleared")
        write("  \x1b[2mEvery project's next build/install will re-fetch what it needs.\x1b[0m")
    end
end

pub fn cmd_langs() is
    print_banner()
    write("  \x1b[1mSupported languages in workspace-special:\x1b[0m")
    write("")
    let langs: [[string]] = [
        ["h#",      "H# (H-Sharp)  — primary language"],
        ["rust",    "Rust          — cargo build"],
        ["c++",     "C++           — g++/clang++"],
        ["c",       "C             — gcc/clang"],
        ["odin",    "Odin          — odin build"],
        ["zig",     "Zig           — zig build"],
        ["crystal", "Crystal       — crystal build"],
        ["go",      "Go            — go build"],
        ["python",  "Python        — syntax check only"],
    ]
    let mut i: int = 0
    while i < array_len(langs) is
        write("    \x1b[36m" + string_pad_right(langs[i][0], 10) + "\x1b[0m  " + langs[i][1])
        i += 1
    end
    write("")
end
