extern dynamic [c] is
    fn system(cmd: string) -> int
    fn exit(code: int)
end

fn find_h_sharp() -> string is
    let bins: [string] = ["h#", "/usr/bin/h#", "hsharp"]
    for b in bins is
        if system("command -v " + b + " >/dev/null 2>&1") == 0 is return b end
    end
    return "h#"
end

;; ── Argument helpers ──────────────────────────────────────────────────────────

pub fn arg_at(args: [string], argc: int, i: int) -> string is
    if i < argc is return args[i] end
    return ""
end

pub fn arg_has(args: [string], argc: int, flag: string) -> bool is
    let mut i: int = 0
    while i < argc is
        if args[i] == flag is return true end
        i += 1
    end
    return false
end

pub fn args_from(args: [string], argc: int, start: int) -> [string] is
    let mut out: [string] = []
    let mut i: int = start
    while i < argc is
        out = array_push(out, args[i])
        i += 1
    end
    return out
end

pub fn args_positional(args: [string], argc: int) -> [string] is
    let mut out: [string] = []
    let mut i: int = 0
    while i < argc is
        if !string_starts_with(args[i], "-") is out = array_push(out, args[i]) end
        i += 1
    end
    return out
end

