extern dynamic [c] is
    fn system(cmd: string) -> int
end

pub struct TestOutcome is
    pub name:    string
    pub passed:  bool
    pub output:  string
    pub elapsed: int
end

fn gather_test_files(extra: [string], extra_count: int) -> [string] is
    if extra_count > 0 is
        let mut picked: [string] = []
        let mut i: int = 0
        while i < extra_count is
            if !string_starts_with(extra[i], "--") is
                picked = array_push(picked, extra[i])
            end
            i += 1
        end
        return picked
    end

    let tmp: string = "/tmp/vira_test_scan_" + to_string(proc_id()) + ".txt"
    system("find . -name '*.h#' ! -path './build/*' | grep -E '(test|spec)' | sort > " + tmp + " 2>/dev/null")
    system("grep -rl '#\\[test\\]' src/ 2>/dev/null | sort >> " + tmp + " 2>/dev/null")
    let content: string = file_read(tmp)
    file_delete(tmp)
    if content == "" is
        let empty: [string] = []
        return empty
    end

    let lines: [string] = string_split(content, "\n")
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(lines) is
        let l: string = string_trim(lines[i])
        if l == "" is i += 1 continue end
        let mut dup: bool = false
        let mut j: int = 0
        while j < array_len(out) is
            if out[j] == l is dup = true end
            j += 1
        end
        if !dup is out = array_push(out, l) end
        i += 1
    end
    return out
end

fn extract_test_names(content: string) -> [string] is
    let mut names: [string] = []
    let lines: [string] = string_split(content, "\n")
    let n: int = array_len(lines)
    let mut i: int = 0
    while i < n - 1 is
        if string_trim(lines[i]) == "#[test]" is
            let next: string = string_trim(lines[i + 1])
            if string_starts_with(next, "fn ") is
                let rest: string = string_slice(next, 3, string_len(next))
                let paren: int = string_find(rest, "(")
                let name: string = if paren >= 0 then string_slice(rest, 0, paren) else rest
                names = array_push(names, string_trim(name))
            end
        end
        i += 1
    end
    return names
end

fn run_one_test(file: string, name: string) -> TestOutcome is
    let t0: int = time_ms()
    let tmp: string = "/tmp/vira_test_out_" + to_string(proc_id()) + ".txt"
    let hsh: string = if system("command -v h# >/dev/null 2>&1") == 0 then "h#" else "hsharp"
    let cmd: string = hsh + " check " + file + " --test " + name + " 2>&1"
    let rc: int = system(cmd + " > " + tmp)
    let output: string = file_read(tmp)
    file_delete(tmp)
    return TestOutcome { name: name, passed: rc == 0, output: output, elapsed: time_ms() - t0 }
end

pub fn cmd_test(extra: [string], extra_count: int, filter: string, verbose: bool) -> int is
    write("")
    write("  \x1b[1;36mvira test\x1b[0m  H# Test Runner")
    write("")

    let files: [string] = gather_test_files(extra, extra_count)
    let n: int = array_len(files)

    if n == 0 is
        write("  \x1b[2mNo .h# test files found.\x1b[0m")
        write("  \x1b[2mPlace #[test] fn blocks in src/ or name files *test*.h#\x1b[0m")
        return 0
    end

    let mut total_passed: int = 0
    let mut total_failed: int = 0
    let mut total_files:  int = 0
    let mut i: int = 0

    while i < n is
        let file: string = files[i]
        if !file_exists(file) is i += 1 continue end

        let names: [string] = extract_test_names(file_read(file))
        let tn: int = array_len(names)
        if tn == 0 is i += 1 continue end

        write("  \x1b[2m" + file + "\x1b[0m")
        total_files += 1

        let mut j: int = 0
        while j < tn is
            let name: string = names[j]
            if filter != "" && !string_contains(name, filter) is
                j += 1
                continue
            end

            let res: TestOutcome = run_one_test(file, name)

            if res.passed is
                write("  \x1b[32m✓\x1b[0m  " + name + "  \x1b[2m(" + to_string(res.elapsed) + "ms)\x1b[0m")
                total_passed += 1
            else is
                write("  \x1b[31m✗\x1b[0m  " + name + "  \x1b[2m(" + to_string(res.elapsed) + "ms)\x1b[0m")
                if res.output != "" && (verbose || total_failed < 3) is
                    let out_lines: [string] = string_split(res.output, "\n")
                    let mut k: int = 0
                    while k < array_len(out_lines) && k < 8 is
                        let l: string = string_trim(out_lines[k])
                        if l != "" is write("       \x1b[31m" + l + "\x1b[0m") end
                        k += 1
                    end
                end
                total_failed += 1
            end
            j += 1
        end
        write("")
        i += 1
    end

    write("  \x1b[2m" + string_repeat("─", 48) + "\x1b[0m")

    if total_failed == 0 is
        write("  \x1b[32m✓\x1b[0m  " + to_string(total_passed) + " test(s) passed in " +
              to_string(total_files) + " file(s)")
        return 0
    else is
        write("  \x1b[31m✗\x1b[0m  " + to_string(total_passed) + "/" +
              to_string(total_passed + total_failed) + " passed, " +
              to_string(total_failed) + " failed")
        return 1
    end
end
